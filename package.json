{
  "name": "@prutet/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Prutet zero-knowledge relay — IPFS pin proxy + emergency dispatcher.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:watch": "nodemon --watch src --ext ts,json --exec \"tsx src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "usage:report": "tsx scripts/weekly-report.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@solana/web3.js": "^1.98.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "kubo-rpc-client": "^4.1.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "opentimestamps": "^0.4.9",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "twilio": "^5.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
